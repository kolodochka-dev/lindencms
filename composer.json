{
    "name": "lindencms/cms",
    "description": "LindenCMS - Complete CMS solution with dynamic content modeling for Laravel.",
    "type": "library",
    "require": {
        "php": "^8.5",
        "laravel/framework": "^12.0|^13.0",
        "laravel/fortify": "^1.37",
        "intervention/image": "^3.11",
        "lindencms/templator": "^0.1.0",
        "lindencms/core": "^0.1.0",
        "brick/math": "^0.14.2 || ^0.15 || ^0.16 || ^0.17 || ^0.18"
    },
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "LindenCMS\\Cms\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "LindenCMS\\Cms\\CmsServiceProvider"
            ]
        }
    },
    "authors": [
        {
            "name": "Kolodochka Alexey",
            "email": "kolodochka.alesha@gmail.com"
        }
    ],
    "minimum-stability": "beta"
}
